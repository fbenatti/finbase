# Secrets and local environment files
.env
.env-*
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Frontend dependencies and builds
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Local databases, Iceberg warehouse and runtime logs
catalog.db
data/
worker.log
*.log
.runtime-logs/
backups/scheduled/

# Large legacy/export artifacts stay on the local filesystem and must never
# re-enter Git history (GitHub rejects individual files above 100 MiB).
/backups/*.sql
/FinOps_v2.5.3_FROZEN_LOCAL_CORRIGIDO/report-cloud-full-azure.csv

# Artefatos de auditoria/rollback da iniciativa Azure FinOps (snapshots de
# metadata e manifestos). Não versionar: são grandes e específicos do ambiente.
/backups/azure-finops-*/

# Files created when restoring a full backup on a host.
/postgres/
/BACKUP_MANIFEST.json

# A main versiona este virtualenv (28k arquivos / ~700 MB). Ele não deve voltar
# para o controle de versão em nenhum merge.
/.venv-linux/

# OS/editor files
.DS_Store
.idea/
.vscode/
