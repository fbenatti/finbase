# Development profile: single worker consumer, modest CPU parallelism, one Trino worker.
OPENFINOPS_WORKER_CONCURRENCY=1
REPROCESS_CPU_WORKERS=1
REPROCESS_CLASSIFICATION_CHUNK_ROWS=50000
REPROCESS_BATCH_ROWS=100000
REPROCESS_MEMORY_LIMIT_MB=6144
REPROCESS_WORKER_MAX_TASKS=6

TRINO_WORKERS=1

# Local stack without Docker for API/worker (see start-local.sh)
TRINO_URL=http://localhost:8080
OPENFINOPS_WORKER_RUNTIME_DIR=/tmp/openfinops-worker
DATABASE_URL=postgresql+asyncpg://finops:finops@localhost:5433/finops
DATABASE_URL_SYNC=postgresql://finops:finops@localhost:5433/finops
ICEBERG_LOCAL_WAREHOUSE=./apps/data/iceberg
