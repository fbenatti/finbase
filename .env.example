# OpenFinops runtime profile (copy to .env and adjust per environment)
#
# Docker Compose note: `deploy.replicas` is ignored by plain `docker compose up`.
# Scale Trino workers explicitly (do not exceed Docker Desktop RAM):
#   TRINO_WORKERS=1 docker compose up -d --scale trino-worker=1

# --- ETL worker pool ---
OPENFINOPS_WORKER_CONCURRENCY=3
# >=2: reprocess Silver em paralelo para fatias diferentes (origem+mês exclusivos por lock)
OPENFINOPS_REPROCESS_SLICE_PARALLEL=1
OPENFINOPS_WORKER_RUNTIME_DIR=/run/openfinops-worker
REPROCESS_CPU_WORKERS=2
REPROCESS_CLASSIFICATION_CHUNK_ROWS=50000
REPROCESS_BATCH_ROWS=100000
REPROCESS_MEMORY_LIMIT_MB=
REPROCESS_MEMORY_MIN_AVAILABLE_RATIO=0.10
REPROCESS_WORKER_MAX_TASKS=6

# --- Trino cluster ---
# Default 1 worker: Docker Desktop on this host is ~8 GiB. Extra workers OOM
# the coordinator (exit 137) and show up as PAGE_TRANSPORT_ERROR.
# Trino reads the Iceberg JDBC catalog from the host PostgreSQL (see
# infra/trino/catalog/iceberg.properties). docker-compose.yml maps
# host.docker.internal for Linux; the canonical dev DB listens on localhost:5433.
TRINO_WORKERS=1
TRINO_MAX_CONCURRENT=4
TRINO_URL=http://trino:8080
TRINO_USER=finops
TRINO_CATALOG=iceberg

# --- Iceberg warehouse ---
# Shared local warehouse. Use ./apps/data/iceberg in local dev (start-local.sh);
# containers (API/worker/Trino) use /data/iceberg mounted to the same directory.
ICEBERG_LOCAL_WAREHOUSE=./apps/data/iceberg

# --- Database (Compose internal network) ---
DATABASE_URL=postgresql+asyncpg://finops:finops@postgres:5432/finops
DATABASE_URL_SYNC=postgresql://finops:finops@postgres:5432/finops
